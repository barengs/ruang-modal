APP_NAME="Ekosistem Alumni SMA Double Track"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ruangmodal.id
APP_PORT=8083
APP_IMAGE=ghcr.io/barengs/ruang-modal:latest

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (Pilih "mysql" atau "sqlite")
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ruang_modal
DB_USERNAME=ruang_modal
DB_PASSWORD=ganti_password_db_kuat
DB_ROOT_PASSWORD=ganti_password_root_kuat

# Jika menggunakan SQLite di dalam container:
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite

# Otomatisasi saat Container Start
RUN_MIGRATIONS=true
RUN_SEEDER=false
RUN_QUEUE_WORKER=true

# JWT Authentication
JWT_SECRET=
JWT_TTL=120

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@doubletrack.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
